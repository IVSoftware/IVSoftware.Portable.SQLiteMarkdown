<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

	<PropertyGroup>
		<AssemblyOriginatorKeyFile>D:\PFX\ivsoft-240410.pfx</AssemblyOriginatorKeyFile>
		<SignAssembly>true</SignAssembly>
	</PropertyGroup>

  <ItemGroup>
    <Compile Remove="Migrate\**" />
    <EmbeddedResource Remove="Migrate\**" />
    <None Remove="Migrate\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="$(PkgIVSoftware_GlyphProvider_Winforms)\contentFiles\any\net8.0-windows7.0\Fonts\icon-basics\config.json" />
    <Content Remove="$(PkgIVSoftware_GlyphProvider_Winforms)\contentFiles\any\net8.0-windows7.0\Fonts\icon-basics\font\icon-basics.ttf" />
    <Content Remove="$(PkgIVSoftware_GlyphProvider_Winforms)\contentFiles\any\net8.0-windows7.0\Fonts\icon-basics\font\icon-basics.woff" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="$(PkgIVSoftware_GlyphProvider_Winforms)\contentFiles\any\net8.0-windows7.0\Fonts\icon-basics\font\icon-basics.woff" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(PkgIVSoftware_GlyphProvider_Winforms)\contentFiles\any\net8.0-windows7.0\Fonts\icon-basics\config.json" />
    <EmbeddedResource Include="$(PkgIVSoftware_GlyphProvider_Winforms)\contentFiles\any\net8.0-windows7.0\Fonts\icon-basics\font\icon-basics.ttf" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="IVSoftware.Portable.Common" Version="*-*" />
		<PackageReference Include="IVSoftware.GlyphProvider.Winforms" Version="*" GeneratePathProperty="true" />
		<PackageReference Include="IVSoftware.Portable.Threading" Version="2.0.0-beta" />
		<PackageReference Include="IVSoftware.Portable.Xml.Linq.XBoundObject" Version="2.1.0-rc" />
		<PackageReference Include="Newtonsoft.Json" Version="*" />
		<PackageReference Include="sqlite-net-pcl" Version="*" />
		<PackageReference Include="IVSoftware.Portable.WatchdogTimer" Version="2.0.0-rc" />
	</ItemGroup>

	<!-- Debug mode uses local project reference -->
	<ItemGroup Condition="'$(Configuration)' == 'Debug'">
		<ProjectReference Include="..\IVSoftware.Portable.SQLiteMarkdown\IVSoftware.Portable.SQLiteMarkdown.csproj" />
	</ItemGroup>

	<!-- Release mode uses NuGet prerelease version -->
	<ItemGroup Condition="'$(Configuration)' == 'Release'">
		<PackageReference Include="IVSoftware.Portable.SQLiteMarkdown" Version="2.0.0-alpha31" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\IVSoftware.Portable.SQLiteMarkdown.MSTest\IVSoftware.Portable.SQLiteMarkdown.MSTest.csproj" />
	</ItemGroup>

</Project>
